#!/usr/bin/env bash
# Run a command as the factory sandbox user ({{ pi_remote_user }}) with its toolchain on PATH.
# Called by the app factory controller through sudo; see /etc/sudoers.d/app-factory.
umask 0002
export HOME="/home/{{ pi_remote_user }}"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export CHROMIUM_PATH=/usr/bin/chromium
export NPM_CONFIG_UPDATE_NOTIFIER=false
# CI uses the default 8787; builder sessions use their own port so both can run e2e at once.
export E2E_PORT="${E2E_PORT:-8790}"

# Every descendant inherits this marker, even one that detaches into its own session.
export FACTORY_SANDBOX_ID="$$-$RANDOM$RANDOM"
"$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
wait "$child"
rc=$?
while kill -0 "$child" 2>/dev/null; do
  wait "$child"
  rc=$?
done

# Kill whatever the command left behind, such as an e2e web server holding a port CI needs.
for env in /proc/[0-9]*/environ; do
  pid="${env#/proc/}"; pid="${pid%/environ}"
  [ "$pid" = "$$" ] && continue
  grep -qzx "FACTORY_SANDBOX_ID=$FACTORY_SANDBOX_ID" "$env" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
done

# Files copied or created with restrictive modes must stay writable by the controller's group.
case "$PWD" in
  {{ app_factory_home }}/work/*|{{ app_factory_home }}/runs/*|{{ app_factory_home }}/evals/*) chmod -R g+rwX . 2>/dev/null || true ;;
esac
exit "$rc"
