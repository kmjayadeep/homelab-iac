[Unit]
Description=Check OpenClaw Vault Agent and certificate health
After=network-online.target vault-agent.service
Wants=network-online.target
OnFailure=openclaw-tls-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/check-openclaw-tls
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
