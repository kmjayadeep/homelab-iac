#!/usr/bin/env bash
set -e

credential={{ vault_agent_cloudflare_destination | quote }}
timeout={{ vault_agent_credential_wait_seconds | int }}

for ((attempt = 0; attempt < timeout; attempt++)); do
  if [[ -s "$credential" ]] &&
    [[ "$(stat -c '%U:%G:%a' "$credential")" == "root:root:600" ]]; then
    exit 0
  fi
  sleep 1
done

printf 'Certbot credential is not ready or has unsafe metadata: %s\n' "$credential" >&2
exit 1
