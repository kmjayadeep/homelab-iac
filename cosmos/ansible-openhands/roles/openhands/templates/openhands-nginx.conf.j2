map $http_upgrade $openhands_connection_upgrade {
  default upgrade;
  '' close;
}

# WebSocket/editor URLs can carry session credentials in query parameters.
log_format openhands_no_query '$remote_addr [$time_local] '
  '"$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
  listen 80;
  listen [::]:80;
  server_name {{ openhands_domain }};
  access_log /var/log/nginx/openhands.access.log openhands_no_query;
  return 301 https://{{ openhands_domain }}$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name {{ openhands_domain }};

  ssl_certificate /etc/letsencrypt/live/{{ openhands_domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ openhands_domain }}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:OpenHandsSSL:10m;
  ssl_session_timeout 1d;

  access_log /var/log/nginx/openhands.access.log openhands_no_query;
  auth_basic "OpenHands";
  auth_basic_user_file /etc/nginx/openhands.htpasswd;
  client_max_body_size 100M;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $openhands_connection_upgrade;
  proxy_buffering off;
  proxy_read_timeout 3600;
  proxy_send_timeout 3600;

  # The pinned official image serves Canvas under /canvas.
  location = / {
    return 302 /canvas;
  }

  location / {
    proxy_pass http://127.0.0.1:8000;
  }
}
